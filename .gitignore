# --- Backend (Python) ---
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env

# Fotos de referencia de empleadas (datos biométricos, nunca a git).
# enroll_face.py crea una carpeta por persona (face_data/<nombre>/) —
# ignoramos todo el contenido excepto el README con instrucciones.
backend/app/face_data/**
!backend/app/face_data/README.md

